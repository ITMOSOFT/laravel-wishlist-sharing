{
  "name": "itmosoft/laravel-wishlist-sharing",
  "description": "Secure, expiring share links and access tracking for Laravel wishlist models.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "ItmoSoft\\WishlistSharing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ItmoSoft\\WishlistSharing\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "ItmoSoft\\WishlistSharing\\WishlistSharingServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}